{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git diff --stat)",
      "Bash(node scripts/validate-agent-kit.mjs)",
      "Bash(node --test scripts/tests/hooks.test.mjs)",
      "PowerShell(git status)",
      "PowerShell(git diff --stat)",
      "PowerShell(node scripts/validate-agent-kit.mjs)",
      "PowerShell(node --test scripts/tests/hooks.test.mjs)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.mcp.json)",
      "Edit(/.github/workflows/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(/.git/**)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git push --force *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -fd *)",
      "PowerShell(git push --force *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
